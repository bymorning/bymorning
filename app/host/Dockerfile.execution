# Digest-pinned bases (index digests) so the execution image is reproducible. python:3.12-slim is the 2026-11-05
# build (Python 3.12.16), re-pinned for 1.3.3: two fixable High advisories fewer than the 2026-10-28 build.
FROM oven/bun:1.3.11@sha256:0733e50325078969732ebe3b15ce4c4be5082f18c4ac1a0f0ca4839c2e4e42a7 AS bun
FROM python:3.12-slim@sha256:4840d514c583a4d3d8cad3940e68dee6f0f6f3635c12fcd0a3d74c21a5b93a54
COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
USER 1000:1000
WORKDIR /work
