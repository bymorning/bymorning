{
  "name": "@bymorning/host",
  "private": true,
  "version": "1.3.1",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun run --cwd ../../packages/server build -- --entry=app/host/src/index.ts --outdir=../../app/host/dist",
    "build:dev": "bun run --cwd ../../packages/server build -- --dev --entry=app/host/src/dev.ts --outdir=../../app/host/dist",
    "dev": "concurrently --kill-others --names api,web \"bun run dev:api\" \"bun run dev:web\"",
    "dev:api": "PORT=${PORT:-3210} APP_ORIGIN=${APP_ORIGIN:-http://localhost:${WEB_PORT:-3000}} tsx watch src/dev.ts",
    "dev:web": "VITE_GATEWAY_URL=${VITE_GATEWAY_URL:-http://127.0.0.1:${PORT:-3210}} bun run --cwd ../../packages/web dev --host 127.0.0.1 --port ${WEB_PORT:-3000} --strictPort",
    "setup": "docker build -t bymorning-code-interpreter:local -f Dockerfile.execution ../..",
    "start": "bun run build:dev && node ./dist/bymorning.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.34.0",
    "@bymorning/backend-aws": "workspace:*",
    "@bymorning/backend-azure": "workspace:*",
    "@bymorning/core": "workspace:*",
    "@bymorning/plugin-atlassian": "workspace:*",
    "@bymorning/plugin-code-interpreter-agentcore": "workspace:*",
    "@bymorning/plugin-code-interpreter-kubernetes": "workspace:*",
    "@bymorning/plugin-context7": "workspace:*",
    "@bymorning/plugin-google": "workspace:*",
    "@bymorning/plugin-share": "workspace:*",
    "@bymorning/plugin-slack": "workspace:*",
    "@bymorning/schema": "workspace:*",
    "@bymorning/server": "workspace:*",
    "@bymorning/util": "workspace:*",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@bymorning/models": "workspace:*",
    "@bymorning/plugin-code-interpreter-docker": "workspace:*",
    "@bymorning/testing": "workspace:*",
    "@effect/vitest": "catalog:",
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-socket": "0.2.7",
    "@types/node": "catalog:",
    "concurrently": "^10.0.5",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
