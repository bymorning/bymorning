%%{init: {"flowchart": {"wrappingWidth": 260}}}%%
flowchart TD
    subgraph Entry["CUI entry — authenticated channels"]
        E1["Member prompts and<br/>conversation (browser)"]
        E2["Project file uploads<br/>(≤20 MiB per request)"]
        E3["Tool results (Code Interpreter,<br/>authorized integrations)"]
        E4["API callers<br/>(/inference, /mcp)"]
    end
    subgraph Processing["Processing — Gateway memory (ephemeral)"]
        P1["Session Runs<br/>(agent loop)"]
        P2["Code Interpreter sandbox<br/>(AgentCore or Kubernetes) —<br/>code + output, no network"]
        P3["Routing judge<br/>(participant turns only)"]
    end
    subgraph Stored["Stored — customer account or subscription (encrypted)"]
        S1["PostgreSQL 17<br/>(RDS or Flexible Server)"]
        S2["S3 bucket or Blob container;<br/>tool-output/ expires 7 days"]
        S3["CloudWatch or Azure logs;<br/>incidental request context"]
        S4["Database backups<br/>and snapshots"]
    end
