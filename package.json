{
  "name": "@bymorning/enterprise",
  "version": "1.3.1",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "packages/*",
    "plugins/*",
    "backends/*",
    "app/*"
  ],
  "catalog": {
    "@ast-grep/cli": "0.44.0",
    "@effect/opentelemetry": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/sql-pg": "4.0.0-rc.112",
    "@effect/tsgo": "^0.24.3",
    "@effect/vitest": "4.0.0-rc.112",
    "@solidjs/testing-library": "^0.8.10",
    "@solidjs/router": "^0.15.1",
    "@tanstack/solid-query": "5.91.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/user-event": "^14.6.1",
    "@tsconfig/node22": "^22",
    "@types/node": "^22",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "drizzle-kit": "1.0.0-rc.5-ab785fc",
    "drizzle-orm": "1.0.0-rc.5-ab785fc",
    "effect": "4.0.0-rc.112",
    "jsdom": "^26.1.0",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "^3.6.2",
    "sst": "4.17.1",
    "solid-js": "^1.9.7",
    "vite": "^7.0.6",
    "vite-plugin-solid": "^2.11.8",
    "tsx": "^4",
    "@effect/atom-solid": "4.0.0-rc.112",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "@opencode-ai/client": "^0.0.0-next-17074",
    "@opencode-ai/ai": "0.0.0-beta-19192",
    "@opencode-ai/codemode": "1.18.4",
    "oauth4webapi": "3.8.8"
  },
  "scripts": {
    "prepare": "effect-tsgo patch",
    "dev": "bun run --cwd app/host dev",
    "dev:server": "bun run --cwd app/host dev:api",
    "dev:web": "bun run --cwd app/host dev:web",
    "dev:docs": "bun run --cwd packages/docs dev",
    "sync:models": "bun run --filter @bymorning/models sync",
    "check:models": "bun run --filter @bymorning/models check:generated",
    "format": "prettier --ignore-unknown --write '*' '.oxlintrc.json'",
    "format:check": "prettier --ignore-unknown --check '*' '.oxlintrc.json'",
    "lint": "oxlint && bun run lint:patterns && bun run lint:core-deps",
    "lint:patterns": "ast-grep scan -c script/ast-grep/sgconfig.yml packages/core/src packages/server/src",
    "lint:core-deps": "bun script/lint-core-deps.ts",
    "test:lint-rules": "ast-grep test -c script/ast-grep/sgconfig.yml",
    "typecheck": "bun run typecheck:packages && bun run typecheck:plugins && bun run typecheck:apps",
    "typecheck:packages": "bun run --filter './packages/[!w]*' typecheck",
    "typecheck:plugins": "bun run --filter './plugins/*' --filter './backends/*' typecheck",
    "typecheck:apps": "bun run --cwd packages/web typecheck && bun run typecheck:hosts",
    "typecheck:hosts": "bun run --cwd app/host typecheck",
    "test:core": "bun run --cwd packages/core test",
    "test:protocol": "bun run --cwd packages/protocol test",
    "test:server": "bun run --cwd packages/server test",
    "test:host": "bun run --cwd app/host test",
    "test:application": "bun run --cwd packages/testing test -- test/oidc-login.test.ts test/chat.test.ts test/seeded-provider.test.ts test/azure-auth.test.ts test/code-interpreter-kubernetes.test.ts",
    "test:observability": "bun run --cwd packages/observability test",
    "test:codegen": "bun run --cwd packages/httpapi-codegen test",
    "test:schema": "bun run --cwd packages/schema test",
    "test:web": "bun run --cwd packages/web test",
    "test:web:e2e": "bun run --cwd packages/web test:e2e",
    "test:web:timeline": "bun run --cwd packages/web test:browser:timeline",
    "check": "bun run format:check && bun run test:lint-rules && bun run lint && bun run typecheck && bun run check:models && bun run --cwd packages/protocol check:generated && bun run --cwd packages/client check:generated && bun run test:codegen && bun run test:core && bun run test:protocol && bun run test:server && bun run test:host && bun run test:application && bun run test:observability && bun run test:schema && bun run test:web && bun run test:web:e2e && bun run test:web:timeline",
    "local": "bun run --cwd app/host start",
    "test:solid": "bun run --cwd packages/client test:solid"
  },
  "devDependencies": {
    "@ast-grep/cli": "catalog:",
    "@effect/tsgo": "catalog:",
    "@playwright/test": "1.59.1",
    "@tsconfig/node22": "catalog:",
    "effect": "catalog:",
    "marked": "18.0.7",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "sst": "catalog:"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112",
    "valibot": "^1.4.2",
    "lodash-es": "^4.18.1",
    "@scalar/json-magic": "0.15.5",
    "seroval": "^1.6.3",
    "seroval-plugins": "^1.6.3",
    "proxy-addr": "^2.0.8",
    "source-map-js": "^1.2.2",
    "shell-quote": "^1.11.0",
    "@modelcontextprotocol/sdk": "^1.31.0"
  },
  "patchedDependencies": {
    "@tanstack/virtual-core@3.17.8": "patches/@tanstack%2Fvirtual-core@3.17.8.patch",
    "@opencode-ai/ai@0.0.0-beta-19192": "patches/@opencode-ai%2Fai@0.0.0-beta-19192.patch",
    "@corvu/drawer@0.2.4": "patches/@corvu%2Fdrawer@0.2.4.patch"
  },
  "prettier": {
    "semi": false,
    "printWidth": 120
  }
}
