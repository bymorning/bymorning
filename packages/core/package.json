{
  "name": "@bymorning/core",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "db": "drizzle-kit",
    "db:check": "bun run script/db-check.ts",
    "test": "vitest run --exclude='test/integration/**'",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "exports": {
    "./*": "./src/*.ts",
    "./account/*": null,
    "./agent/*": null,
    "./auth/*": null,
    "./auth-provider/*": null,
    "./audit/*": null,
    "./bus/*": null,
    "./cipher/*": null,
    "./database/*": null,
    "./integration/*": null,
    "./inference": null,
    "./inference/*": null,
    "./instruction/*": null,
    "./permission/*": null,
    "./policy/*": null,
    "./project/*": null,
    "./plugin/*": null,
    "./plugin/project-materializer": "./src/plugin/project-materializer.ts",
    "./plugin/source": "./src/plugin/source.ts",
    "./plugin/hooks": "./src/plugin/hooks.ts",
    "./plugin/package": "./src/plugin/package.ts",
    "./plugin/activation": "./src/plugin/activation.ts",
    "./plugin/configuration": "./src/plugin/configuration.ts",
    "./plugin/runtime": "./src/plugin/runtime.ts",
    "./plugin/supervisor": "./src/plugin/supervisor.ts",
    "./model/*": null,
    "./provider-execution": null,
    "./provider-execution/*": null,
    "./session/*": null,
    "./storage/*": null,
    "./session/tool-admission": "./src/session/tool-admission.ts",
    "./tool/*": null,
    "./tool-registry/*": null,
    "./websearch/*": null,
    "./workspace/*": null
  },
  "dependencies": {
    "@bymorning/models": "workspace:*",
    "@bymorning/observability": "workspace:*",
    "@bymorning/plugin": "workspace:*",
    "@bymorning/schema": "workspace:*",
    "@bymorning/util": "workspace:*",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.4.0",
    "@effect/platform-node": "catalog:",
    "@effect/sql-pg": "catalog:",
    "@opencode-ai/ai": "catalog:",
    "@opencode-ai/codemode": "catalog:",
    "@standard-schema/spec": "^1.0.0",
    "diff": "8.0.4",
    "drizzle-orm": "catalog:",
    "effect": "catalog:",
    "htmlparser2": "8.0.2",
    "oauth4webapi": "catalog:",
    "minimatch": "^10.2.6",
    "sst": "catalog:"
  },
  "devDependencies": {
    "@bymorning/testing": "workspace:*",
    "@effect/vitest": "catalog:",
    "@modelcontextprotocol/server": "2.3.1",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "pg-connection-string": "^2.9.0",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
