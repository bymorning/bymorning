{
  "name": "@bymorning/ui",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./src/theme-preload.js"
  ],
  "exports": {
    "./accordion": "./src/public/accordion.ts",
    "./action-menu": "./src/public/action-menu.ts",
    "./avatar": "./src/public/avatar.ts",
    "./button": "./src/public/button.ts",
    "./checkbox": "./src/public/checkbox.ts",
    "./collapsible": "./src/public/collapsible.ts",
    "./confirm-dialog": "./src/public/confirm-dialog.ts",
    "./dialog": "./src/public/dialog.ts",
    "./dropdown-menu": "./src/public/dropdown-menu.ts",
    "./field": "./src/public/field.ts",
    "./file-icon": "./src/public/file-icon.ts",
    "./file-tree": "./src/public/file-tree.ts",
    "./icon": "./src/public/icon.ts",
    "./icon-button": "./src/public/icon-button.ts",
    "./keybind": "./src/public/keybind.ts",
    "./loader": "./src/public/loader.ts",
    "./material-picker": "./src/public/material-picker.ts",
    "./menu": "./src/public/menu.ts",
    "./progress-circle": "./src/public/progress-circle.ts",
    "./project-avatar": "./src/public/project-avatar.ts",
    "./radio": "./src/public/radio.ts",
    "./resize-handle": "./src/public/resize-handle.ts",
    "./scroll-view": "./src/public/scroll-view.ts",
    "./search-select": "./src/public/search-select.ts",
    "./segmented-control": "./src/public/segmented-control.ts",
    "./select": "./src/public/select.ts",
    "./spinner": "./src/public/spinner.ts",
    "./switch": "./src/public/switch.ts",
    "./tag": "./src/public/tag.ts",
    "./text-input": "./src/public/text-input.ts",
    "./text-shimmer": "./src/public/text-shimmer.ts",
    "./textarea": "./src/public/textarea.ts",
    "./toast": "./src/public/toast.ts",
    "./tooltip": "./src/public/tooltip.ts",
    "./theme": "./src/theme/index.ts",
    "./context/dialog": "./src/context/dialog.tsx",
    "./context/i18n": "./src/context/i18n.tsx",
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/theme/styles/tokens/index.css",
    "./fonts.css": "./src/theme/styles/fonts.css",
    "./theme-preload.js": "./src/theme-preload.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings src test scripts *.ts",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "bun run theme:check && vite build --config test/browser/vite.config.ts",
    "theme:generate": "bun run scripts/generate-theme-css.ts",
    "theme:check": "bun run scripts/generate-theme-css.ts --check"
  },
  "dependencies": {
    "@kobalte/core": "0.13.13",
    "@solid-primitives/event-listener": "^2.4.6",
    "@solid-primitives/resize-observer": "^2.2.0",
    "solid-sonner": "0.3.1",
    "tailwindcss": "^4.1.13"
  },
  "peerDependencies": {
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@solidjs/testing-library": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "solid-js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
