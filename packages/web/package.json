{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@bymorning/web",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run theme:check && vite build",
    "preview": "vite preview",
    "test:browser:timeline": "playwright test --config test-browser/playwright.config.ts",
    "benchmark:transcript": "playwright test --config test-browser/transcript-performance.playwright.config.ts",
    "test:e2e": "playwright test",
    "test:application": "node --import tsx ./node_modules/@playwright/test/cli.js test --config playwright.application.config.ts",
    "docs:screenshots": "PLAYWRIGHT_MANAGED_CHROMIUM=1 playwright test e2e/docs/screenshots.spec.ts --project=chromium --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "test": "VITE_GATEWAY_URL=http://localhost:3210 vitest run --environment jsdom",
    "typecheck": "tsc --noEmit && bun run typecheck:application",
    "typecheck:application": "tsc --noEmit -p e2e/application/tsconfig.json",
    "theme:generate": "bun run scripts/generate-theme-css.ts",
    "theme:check": "bun run scripts/generate-theme-css.ts --check"
  },
  "dependencies": {
    "@bymorning/client": "workspace:*",
    "@bymorning/plugin-share": "workspace:*",
    "@bymorning/schema": "workspace:*",
    "@effect/atom-solid": "catalog:",
    "@kobalte/core": "0.13.14",
    "@shikijs/stream": "4.5.0",
    "@solid-primitives/event-listener": "^2.4.6",
    "@solid-primitives/resize-observer": "^2.2.0",
    "@solid-primitives/storage": "^4.4.0",
    "@solidjs/router": "^0.16.3",
    "@tanstack/solid-query": "catalog:",
    "@tanstack/solid-virtual": "3.13.49",
    "chart.js": "4.6.1",
    "dompurify": "3.4.17",
    "effect": "catalog:",
    "fuzzysort": "3.1.0",
    "katex": "0.17.0",
    "luxon": "3.7.2",
    "marked": "18.1.1",
    "marked-shiki": "1.2.1",
    "mermaid": "11.17.2",
    "morphdom": "2.7.8",
    "remend": "1.4.0",
    "shiki": "4.5.0",
    "solid-js": "catalog:",
    "solid-list": "0.3.0",
    "solid-sonner": "0.3.2",
    "strip-ansi": "7.2.0"
  },
  "devDependencies": {
    "@bymorning/testing": "workspace:*",
    "@playwright/test": "1.64.1",
    "@solidjs/testing-library": "catalog:",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/luxon": "^3.7.6",
    "@types/node": "catalog:",
    "jsdom": "catalog:",
    "postcss": "^8.5.31",
    "solid-devtools": "^0.34.3",
    "tailwindcss": "^4.1.13",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:",
    "vitest": "catalog:"
  }
}
